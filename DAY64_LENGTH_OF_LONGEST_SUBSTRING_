Q114: Write a program to take a string s as input. The task is to find the length of the longest substring without repeating characters. Print the length as output.

/*
Sample Test Cases:
Input 1:
s = "abcabcbb"
Output 1:
3

Input 2:
s = "bbbbb"
Output 2:
1

Input 3:
s = "pwwkew"
Output 3:
3

*/

#include <stdio.h>
#include <string.h>

int main() {
    char s[1005];           // supports strings up to ~1000 chars
    int last[256];
    int i, start = 0, maxlen = 0, len;

    // Read input string (no spaces). If you need spaces, use fgets instead.
    if (scanf("%s", s) != 1) return 0;

    len = strlen(s);

    // initialize last seen positions to -1
    for (i = 0; i < 256; i++) last[i] = -1;

    for (i = 0; i < len; i++) {
        unsigned char c = (unsigned char)s[i];

        // if this char was seen inside current window, move start
        if (last[c] >= start) {
            start = last[c] + 1;
        }

        // update last seen index for this char
        last[c] = i;

        // update max length
        if (i - start + 1 > maxlen) {
            maxlen = i - start + 1;
        }
    }

    printf("%d\n", maxlen);
    return 0;
}
